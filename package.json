{
  "private": true,
  "name": "sk-components",
  "scripts": {
    "build": "pnpm -r build",
    "build:css": "pnpm -C packages/css build",
    "build:react": "pnpm -C packages/react build",
    "lint": "pnpm -r --no-bail lint",
    "dev": "pnpm -r --parallel dev",
    "format": "prettier --write .",
    "prepare": "husky",
    "demo:dev": "pnpm -C apps/demo dev",
    "demo:build": "pnpm -C apps/demo build",
    "demo:start": "pnpm -C apps/demo start",
    "demo:icons": "pnpm -C apps/demo icons"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "prettier-plugin-css-order": "^2.2.0",
    "prettier-plugin-tailwindcss": "^0.8.1"
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72"
}
