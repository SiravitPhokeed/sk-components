{
  "name": "@suankularb-components/css",
  "version": "3.3.2",
  "description": "Styling for Suankularb Components, the base of all Suankularb Components implementations",
  "license": "ISC",
  "files": [
    "dist/"
  ],
  "exports": {
    "./theme.css": "./dist/_theme.css",
    "./actions.css": "./dist/actions.css",
    "./app-drawer.css": "./dist/app-drawer.css",
    "./app-drawer-item.css": "./dist/app-drawer-item.css",
    "./app-drawer-segment.css": "./dist/app-drawer-segment.css",
    "./button.css": "./dist/button.css",
    "./card.css": "./dist/card.css",
    "./card-content.css": "./dist/card-content.css",
    "./card-header.css": "./dist/card-header.css",
    "./columns.css": "./dist/columns.css",
    "./content-layout.css": "./dist/content-layout.css",
    "./header.css": "./dist/header.css",
    "./interactive.css": "./dist/interactive.css",
    "./material-icon.css": "./dist/material-icon.css",
    "./page-header.css": "./dist/page-header.css",
    "./progress.css": "./dist/progress.css",
    "./section.css": "./dist/section.css",
    "./text.css": "./dist/text.css"
  },
  "scripts": {
    "build": "postcss src/**/*.css --dir dist/ --base src/",
    "dev": "postcss src/**/*.css --dir dist/ --base src/ --watch",
    "format": "postcss src/**/*.css --replace",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "css-declaration-sorter": "^7.2.0",
    "postcss": "^8.5.0",
    "postcss-cli": "^11.0.0"
  }
}
